<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Matjakt - Privacy manifest (krävs av App Store sedan våren 2024).
  Läggs i ios/App/App/PrivacyInfo.xcprivacy efter `npx cap add ios`.
  Innehållet speglar vad appen faktiskt gör (frontend/app + Capacitor 8):
    - Ingen spårning, inga tredjeparts-SDK:er, ingen reklam.
    - Konto = e-postadress (kopplad till användaren) för inloggning.
    - Plats används en gång per "Hitta mig" och sparas i profilen som
      lat/lon för butiksval (kopplad till kontot när man är inloggad).
    - Köp: Premium (i dag Stripe på webben; se docs/IOS_RELEASE.md om IAP).
  Required-reason-API:er: Capacitor läser UserDefaults (CA92.1) och
  filtidsstämplar (C617.1). Verifiera listan i Xcode innan inlämning.
-->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <!-- Namngivna händelser räknas per konto och dygn (api_server.py
           _handle_analytics_event) för att skilja "23 personer" från "en
           person, 23 klick". Aldrig finare tidsstämpel än dygnet, aldrig
           IP, aldrig fritext - men kopplat till kontot, alltså Linked. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <dict>
      <!-- Allergier. De ligger i hushållsmedlemmens profil på servern
           (household/store.py set_profile) och styr vilka recept som får
           föreslås. Det är hälsouppgifter - artikel 9 i GDPR, och
           Health i Apples taxonomi. Att de är frivilliga ändrar inte
           vad de är. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeHealth</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
