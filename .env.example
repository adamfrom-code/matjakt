MATJAKT_HOST=127.0.0.1
MATJAKT_PORT=8000
MATJAKT_FRONTEND_ORIGIN=http://localhost:5500
MATJAKT_API_URL=http://127.0.0.1:8000/api
# Where Stripe redirects the browser back after checkout/the billing portal - the full
# app URL including any subpath (unlike MATJAKT_FRONTEND_ORIGIN, which must be a bare
# origin for the CORS header). Leave unset locally; on Render it's the GitHub Pages
# project URL (https://adamfrom-code.github.io/matjakt).
MATJAKT_APP_URL=
# Sätt till ett eget hemligt värde för att kunna låsa upp Premium på ditt konto
# (POST /api/auth/redeem) innan riktig betalning finns. Tomt värde = inlösen avstängd.
MATJAKT_PREMIUM_CODE=

# Stripe - krävs för riktig prenumeration (59 kr/mån, 499 kr/år). Skapa ett Stripe-konto,
# skapa två "Price" (recurring) under samma Product, och klistra in ID:na här. Tomt värde
# = köpknapparna visar ett tydligt felmeddelande istället för att krascha.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
