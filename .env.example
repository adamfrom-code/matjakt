MATJAKT_HOST=127.0.0.1
MATJAKT_PORT=8000
# Bare origin(s) allowed to call the API (CORS). One value, or several
# comma-separated (used during a domain migration so both the new and old
# frontend origin work at once, e.g. "https://matjakt.store,https://adamfrom-code.github.io").
MATJAKT_FRONTEND_ORIGIN=http://localhost:5500
MATJAKT_API_URL=http://127.0.0.1:8000/api
# Where Stripe redirects the browser back after checkout/the billing portal - the full
# app URL including any subpath (unlike MATJAKT_FRONTEND_ORIGIN, which must be a bare
# origin for the CORS header). Leave unset locally; on Render it's the GitHub Pages
# project URL (https://adamfrom-code.github.io/matjakt).
MATJAKT_APP_URL=
# Sätt till ett eget hemligt värde för att kunna låsa upp Premium på ditt konto
# (POST /api/auth/redeem) innan riktig betalning finns. Tomt värde = inlösen avstängd.
MATJAKT_PREMIUM_CODE=

# Primat (https://primat.nu/api) - riktiga svenska butikspriser (ICA, Coop, Willys,
# Hemköp, Lidl, City Gross), försöks alltid FÖRE butiksskrapning. Tomt värde = appen
# använder Primats gratis demo-API istället (fungerar, men begränsat till 250
# anrop/dag och 25 träffar per sökning) - skrapning täcker resten oavsett. Skaffa en
# riktig nyckel via POST /api/v3/signup (se https://primat.nu/api) för högre gräns.
PRIMAT_API_KEY=

# Valfritt hemligt värde som låser upp GET /api/admin/primat-status (dagens Primat-
# kvotanvändning, skickas som header X-Admin-Token) - rent internt/diagnostiskt, aldrig
# kopplat till ett vanligt konto. Tomt värde = endpointen svarar 404 för alla.
MATJAKT_ADMIN_TOKEN=

# Stripe - krävs för riktig prenumeration (59 kr/mån, 499 kr/år). Skapa ett Stripe-konto,
# skapa två "Price" (recurring) under samma Product, och klistra in ID:na här. Tomt värde
# = köpknapparna visar ett tydligt felmeddelande istället för att krascha.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# E-post - krävs för glömt lösenord och e-postverifiering. Fungerar med vilken
# SMTP-leverantör som helst (Gmail med app-lösenord, SendGrid/Postmark/AWS SES SMTP-relä,
# ...). Tomt värde = de funktionerna visar ett tydligt "inte konfigurerat"-fel istället
# för att krascha eller låtsas att mejlet skickades; konton fungerar ändå.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Nattjobb för prisimport (grocery) --------------------------------------
# Av som standard. Sätt till 1 för att låta backend importera priser själv.
MATJAKT_GROCERY_SCHEDULE_ENABLED=0
# Tider i Europe/Stockholm. Bara Willys, Hemköp och City Gross får schemaläggas
# - ICA trippar AWS WAF vid upprepad hämtning, Coop kräver deras egen nyckel
# och Lidl publicerar inga priser. Utelämnas variabeln används 02:00/03:00/04:00.
MATJAKT_GROCERY_SCHEDULE=Willys=02:00,Hemköp=03:00,City Gross=04:00

# --- Receptbilder ----------------------------------------------------------
# Gratisnyckel från https://www.pexels.com/api/ - används av
# backend/scripts/pexels_recipe_images.py för att hämta receptfotografi.
# Behövs bara när bilder ska uppdateras, aldrig i drift.
PEXELS_API_KEY=

# --- Receptbilder -----------------------------------------------------------
# Pexels ger betydligt bättre matfotografi än Wikimedia Commons. Utan nyckel
# används bara Commons, och fler recept hamnar på needs_image.
# Hämta en gratis nyckel på https://www.pexels.com/api/ och kör sedan:
#   python backend/scripts/backfill_recipe_images.py
PEXELS_API_KEY=

# --- Delat läs-API för andra appar (/api/v1/shared/) ------------------------
# Kommaseparerade app-nycklar som släpper in EN ANNAN APP på /api/v1/shared/
# medan utvecklingslåset är på. En nyckel per konsument, så att en kan
# återkallas utan att slå ut de andra. Ät Upp är den första konsumenten.
#
# Nyckeln öppnar BARA det prefixet - inte konton, priser eller driftvägar.
# Tomt värde = ingen nyckel finns och ingen släpps in (fail-closed).
# Kontraktet är dokumenterat i docs/SHARED_API.md.
MATJAKT_SHARED_API_KEYS=
