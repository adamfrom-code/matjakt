{
  "name": "matjakt",
  "version": "1.0.0",
  "description": "En app där du anger hur mycket pengar du har att handla mat för denna\r vecka och antal personer i hushållet, och får receptförslag +\r inköpslista baserat på de billigaste priserna hos butiker i din närhet.",
  "main": "index.js",
  "scripts": {
    "test": "node --test && node scripts/py.mjs backend/tests/run.py",
    "check": "node --check frontend/app/app.js && node scripts/py.mjs -m compileall -q backend",
    "frontend": "node scripts/py.mjs scripts/serve_frontend.py",
    "backend": "node scripts/py.mjs backend/api_server.py",
    "build": "node scripts/build_frontend.mjs",
    "build:native": "node scripts/build_frontend.mjs dist/native --native --api-url=https://matjakt.onrender.com/api",
    "ios:sync": "npm run build:native && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamfrom-code/matjakt.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/adamfrom-code/matjakt/issues"
  },
  "homepage": "https://github.com/adamfrom-code/matjakt#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "9.39.1"
  }
}
