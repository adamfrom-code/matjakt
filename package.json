{
  "name": "matjakt",
  "version": "1.0.0",
  "description": "En app där du anger hur mycket pengar du har att handla mat för denna\r vecka och antal personer i hushållet, och får receptförslag +\r inköpslista baserat på de billigaste priserna hos butiker i din närhet.",
  "main": "index.js",
  "scripts": {
    "test": "node --test && python -m unittest discover -s backend/tests",
    "check": "node --check frontend/app.js && python -m compileall -q backend",
    "frontend": "python -m http.server 5500 --directory frontend",
    "backend": "python backend/api_server.py"
  },
