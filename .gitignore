backend/venv/
backend/__pycache__/
# Databaserna byggs av collectorer och importskript - de hör inte i git.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
# Ingen SQLite-fil någonstans i repot - backupkatalogen var spårad 2026-08-31..09-06
# (kontodatabas i publikt repo). CI:s säkerhetsjobb vägrar spårade *.db.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Receptkällorna låg tidigare under backend/data/ och behövde undantas här.
# De ligger nu i backend/recipe_sources/ - utanför monteringspunkten, där de
# både versionshanteras och faktiskt syns när Render monterat disken.
*.pyc
.env
.env.*
!.env.example
.DS_Store
node_modules/
.idea/
android/.gradle/
android/build/
android/app/build/
# Renderad marknadsföringsvideo och dess arbetsfiler - byggs om med
# backend/scripts/make_instagram_video.py, hör inte hemma i git (12 MB mp4).
marketing/

# Nattliga backupset (services/backup.py) - aldrig i repot.
backend/data/backups/

# Prisauditens utdata (backend/scripts/audit_pricing.py). Låg tidigare som
# audit_result.json och audit_flags.tsv i repo-roten: genererad data som gav
# varje agent som körde auditen en diff i roten. De två rotfilerna står kvar
# här för att en gammal lokal kopia inte ska smyga tillbaka in.
backend/data/audit/
/audit_result.json
/audit_flags.tsv

# Skärmdumpar från browser-E2E vid fel (tests/e2e/) - aldrig i repot.
backend/tests/e2e/artifacts/

# Butiksskärmbilderna (backend/scripts/make_store_screenshots.py). Arton
# PNG:er på några megabyte som byter innehåll varje gång appens utseende
# ändras - de byggs om inför varje inlämning och laddas upp, de lagras inte.
store/appstore/screenshots/
store/play/screenshots/

# Byggd frontend (scripts/build_frontend.mjs) - byggs i deploy-jobbet.
dist/

# xcodebuild (scripts/ios_mac_pass.sh) - derived data, aldrig i repot.
build/

# Agenternas arbetsträd - aldrig i git
.claude/worktrees/

# K6: coverage-mätningens datafil och HTML-rapport. Genereras av
# `coverage run` (CI-jobbet "Täckning") och av var och en som mäter lokalt -
# aldrig i git. CI:s artefaktgrind vägrar den numera också.
.coverage
.coverage.*
htmlcov/
