{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "frontend"
      ],
      "port": 5500,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "backend"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "kontrollrum",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/py.mjs",
        "--env",
        "MATJAKT_PORT=8010",
        "backend/api_server.py"
      ],
      "port": 8010,
      "autoPort": false
    }
  ]
}
